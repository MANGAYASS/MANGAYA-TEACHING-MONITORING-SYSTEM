  const TT={modal:'teacherTimetableModal',schedule:'ttSchedule',teacher:'ttTeacher',view:'ttView',date:'ttDate',rows:'ttRows',msg:'ttMsg',summary:'ttSummary',day:'ttDayCount',week:'ttWeekCount',month:'ttMonthCount',year:'ttYearCount'};
  const D=['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'];
  function el(id){return document.getElementById(id)}
  function allSchedules(){try{const x=JSON.parse(localStorage.getItem('mangaya_schedules_v4')||'{}');if(Array.isArray(x))return x;return x&&typeof x==='object'?Object.values(x):[]}catch(e){return []}}
  function escTT(v){return String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
  function normDay(v){let x=String(v||'').trim().toUpperCase();const map={MON:'MONDAY',TUE:'TUESDAY',TUES:'TUESDAY',WED:'WEDNESDAY',THU:'THURSDAY',THUR:'THURSDAY',FRI:'FRIDAY',SAT:'SATURDAY',SUN:'SUNDAY'};return map[x]||x}
  function timeLabel(e){return e.session||e.time||e.period||('PERIOD '+(e.periodNo||''))}
  function teacherNames(){const set=new Set();allSchedules().forEach(s=>(s.entries||[]).forEach(e=>{if(e.teacher&&String(e.teacher).trim())set.add(String(e.teacher).trim())}));return [...set].sort((a,b)=>a.localeCompare(b))}
  function scheduleName(s){return s.name||'UNTITLED TIMETABLE'}
  function scheduleEntries(){const out=[];allSchedules().forEach(s=>(s.entries||[]).forEach((e,i)=>out.push({...e,_scheduleId:s.id||s.name||String(i),_scheduleName:scheduleName(s),_type:s.type||'OTHER'})));return out}
  function parseDate(x){return new Date(x+'T00:00:00')}
  function rangeFor(view,date){const d=parseDate(date);if(view==='day')return [d,d];if(view==='week'){const day=d.getDay();const start=new Date(d);start.setDate(d.getDate()-(day===0?6:day-1));const end=new Date(start);end.setDate(start.getDate()+6);return [start,end]}if(view==='month')return [new Date(d.getFullYear(),d.getMonth(),1),new Date(d.getFullYear(),d.getMonth()+1,0)];return [new Date(d.getFullYear(),0,1),new Date(d.getFullYear(),11,31)]}
  function daysInRange(a,b){const out=[];for(let d=new Date(a);d<=b;d.setDate(d.getDate()+1))out.push(new Date(d));return out}
  function entriesForTeacher(name){return scheduleEntries().filter(e=>String(e.teacher||'').trim()===name)}
  function refreshSchedules(){const box=el(TT.schedule),cur=box.value||'ALL',ss=allSchedules();box.innerHTML='<option value="ALL">ALL UPLOADED TIMETABLES</option>'+ss.map((s,i)=>`<option value="${i}">${escTT(scheduleName(s))} — ${escTT(s.type||'OTHER')}</option>`).join('');box.value=[...box.options].some(o=>o.value===cur)?cur:'ALL'}
  function refreshTeachers(){const box=el(TT.teacher),cur=box.value,n=teacherNames();box.innerHTML=n.map(x=>`<option value="${escTT(x)}">${escTT(x)}</option>`).join('');if(cur&&n.includes(cur))box.value=cur}
  function periodCount(name,view,date){const [a,b]=rangeFor(view,date),selectedSchedule=el(TT.schedule)?.value||'ALL',ss=allSchedules(),chosen=ss[Number(selectedSchedule)];const entries=entriesForTeacher(name).filter(e=>selectedSchedule==='ALL'||(chosen&&String(e._scheduleId)===String(chosen.id||chosen.name||'')));let count=0;for(const d of daysInRange(a,b)){const day=D[d.getDay()];count+=entries.filter(e=>normDay(e.day)===day).length}return count}
  function uniqueCountForView(name,view,date){return periodCount(name,view,date)}
  function renderTT(){
    const name=el(TT.teacher).value,date=el(TT.date).value||new Date().toISOString().slice(0,10),view=el(TT.view).value;
    el(TT.date).value=date;
    if(!name){el(TT.rows).innerHTML='<tr><td colspan="5" class="ttEmpty">NO TEACHER FOUND IN THE UPLOADED TIMETABLES.</td></tr>';el(TT.msg).textContent='';['day','week','month','year'].forEach(k=>el(TT[k]).textContent='0');return}
    el(TT.day).textContent=uniqueCountForView(name,'day',date);el(TT.week).textContent=uniqueCountForView(name,'week',date);el(TT.month).textContent=uniqueCountForView(name,'month',date);el(TT.year).textContent=uniqueCountForView(name,'year',date);
    const [a,b]=rangeFor(view,date),days=daysInRange(a,b),selectedSchedule=el(TT.schedule).value,entries=entriesForTeacher(name).filter(e=>selectedSchedule==='ALL'||String(e._scheduleId)===String((allSchedules()[Number(selectedSchedule)]||{}).id||allSchedules()[Number(selectedSchedule)]?.name||'')),rows=[];
    days.forEach(d=>{const day=D[d.getDay()];entries.filter(e=>normDay(e.day)===day).forEach(e=>rows.push({...e,_date:d}))});
    rows.sort((x,y)=>x._date-y._date||String(x.session||'').localeCompare(String(y.session||''))||String(x.className||'').localeCompare(String(y.className||'')));
    el(TT.summary).innerHTML=`<span class="ttTeacherBadge">${escTT(name)}</span> — ${view.toUpperCase()} VIEW | ${rows.length} PERIOD${rows.length===1?'':'S'} SHOWN | ${a.toLocaleDateString()} – ${b.toLocaleDateString()}`;
    el(TT.rows).innerHTML=rows.length?rows.map(e=>`<tr><td>${escTT(e.day)}</td><td>${escTT(timeLabel(e))}</td><td>${escTT(e.className||e.class||'')}</td><td>${escTT(e.subject||'')}</td><td>${escTT(e._scheduleName)}</td></tr>`).join(''):'<tr><td colspan="5" class="ttEmpty">NO PERIODS FOUND FOR THIS TEACHER IN THE SELECTED PERIOD.</td></tr>';
    el(TT.msg).textContent=entries.length?`This teacher has ${entries.length} timetable entries across the uploaded timetables.`:'No timetable entries found for this teacher.';
  }
  function openTT(){refreshSchedules();refreshTeachers();if(!el(TT.date).value)el(TT.date).value=(document.getElementById('date')?.value||new Date().toISOString().slice(0,10));renderTT();showModal(TT.modal)}
  window.openTeacherTimetable=openTT;
  const b=el('teacherTimetableBtn');if(b)b.addEventListener('click',openTT);const mb=el('mainTeacherTimetableBtn');if(mb)mb.addEventListener('click',openTT);
  ['schedule','teacher','view','date'].forEach(k=>{const x=el(TT[k]);if(x)x.addEventListener('change',renderTT)});
  // Make the feature available immediately after login, without changing existing role logic.
  document.addEventListener('DOMContentLoaded',()=>{const x=el('teacherTimetableBtn');if(x)x.style.display='inline-block'});
})();

