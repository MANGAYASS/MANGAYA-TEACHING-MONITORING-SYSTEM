  function renderTT2(){const date=dateVal('ttDate'),mode=$('ttMode').value,view=$('ttView').value,base=filterTT(selectedEntries($('ttSchedule').value));$('ttDayCount').textContent=countFor(base,'day',date);$('ttWeekCount').textContent=countFor(base,'week',date);$('ttMonthCount').textContent=countFor(base,'month',date);$('ttYearCount').textContent=countFor(base,'year',date);const [a,b]=range(view,date),rows=[];days(a,b).forEach(d=>base.filter(e=>day(e.day)===D[d.getDay()]).forEach(e=>rows.push({...e,_d:d})));rows.sort((x,y)=>x._d-y._d||time(x).localeCompare(time(y))||String(x.className||'').localeCompare(String(y.className||'')));$('ttSummary').innerHTML=`<b>${mode==='school'?'FULL SCHOOL TIMETABLE':mode==='form'?'FORM / KIDATO: '+($('ttForm').value==='ALL'?'ALL':esc($('ttForm').value)):mode==='class'?'CLASS: '+($('ttClass').value==='ALL'?'ALL':esc($('ttClass').value)):'TEACHER: '+esc($('ttTeacher').value)}</b> — ${view.toUpperCase()} | ${rows.length} PERIOD${rows.length===1?'':'S'} SHOWN | ${a.toLocaleDateString()} – ${b.toLocaleDateString()}`;$('ttRows').innerHTML=rows.length?rows.map(e=>`<tr><td>${esc(e.day)}</td><td>${esc(time(e))}</td><td>${esc(e.className||e.class||'')}</td><td>${esc(e.subject||'')}</td><td>${esc(e.teacher||'')}</td><td>${esc(e._sname)}</td></tr>`).join(''):'<tr><td colspan="6" class="ttEmpty">NO PERIODS FOUND FOR THIS SELECTION.</td></tr>';return rows}
  function csv(rows){const head=['DAY','TIME/PERIOD','CLASS','SUBJECT','TEACHER','TIMETABLE'];const q=v=>'"'+String(v??'').replace(/"/g,'""')+'"';return [head,...rows.map(e=>[e.day,time(e),e.className||e.class||'',e.subject||'',e.teacher||'',e._sname])].map(r=>r.map(q).join(',')).join('\n')}
  function download(name,text,type='text/csv'){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([text],{type}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
  function downloadTT(){download('MANGAYA_TIMETABLE_CURRENT_VIEW.csv',csv(renderTT2()))}
  function printTT(){const rows=renderTT2(),title=$('ttSummary').innerText;const html=`<!doctype html><html><head><meta charset="utf-8"><title>MANGAYA TIMETABLE</title><style>body{font-family:Arial,sans-serif}h2{text-align:center}table{width:100%;border-collapse:collapse}th,td{border:1px solid #333;padding:6px;text-align:center}th{background:#eee}</style></head><body><h2>MANGAYA SECONDARY SCHOOL</h2><p>${esc(title)}</p><table><tr><th>DAY</th><th>TIME/PERIOD</th><th>CLASS</th><th>SUBJECT</th><th>TEACHER</th><th>TIMETABLE</th></tr>${rows.map(e=>`<tr><td>${esc(e.day)}</td><td>${esc(time(e))}</td><td>${esc(e.className||e.class||'')}</td><td>${esc(e.subject||'')}</td><td>${esc(e.teacher||'')}</td><td>${esc(e._sname)}</td></tr>`).join('')}</table><script>window.print()<\/script></body></html>`;const w=window.open('','_blank');if(w){w.document.write(html);w.document.close()}}
  function loadPeriodRows(view,date,teacher, scheduleId){
