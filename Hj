function sessionStartMinutes(session){
  const x=String(session||'');
  const m=x.match(/(\d{1,2}):(\d{2})/); if(m)return Number(m[1])*60+Number(m[2]);
  if(/MORNING/i.test(x))return 6*60+30;
  if(/EVENING/i.test(x))return 15*60+50;
  return null;
}
function nativeSmsJobsForRange(days=7){
  const jobs=[]; const now=Date.now(); const seen=new Set();
  const lead=Math.max(1,Math.min(60,Number(smsSettings().leadMinutes)||5));
  for(let k=0;k<days;k++){
    const d=new Date(); d.setHours(0,0,0,0); d.setDate(d.getDate()+k); const ds=d.toISOString().slice(0,10);
    const q=smsQueueForDate(ds); const grouped={};
    q.forEach(e=>{
      const mins=sessionStartMinutes(e.session); if(mins===null)return;
      const key=e.teacher+'|'+ds+'|'+mins;
      (grouped[key]??={teacher:e.teacher,phone:e.phone,date:ds,mins,items:[]}).items.push(e);
    });
    Object.values(grouped).forEach(g=>{
      if(!g.phone)return;
      const at=new Date(g.date+'T00:00:00'); at.setMinutes(g.mins-lead);
      const key='MANGAYA|'+g.teacher+'|'+g.date+'|'+g.mins+'|'+g.items.map(x=>x.className+'|'+x.subject).sort().join(';');
      if(seen.has(key))return; seen.add(key);
      const lines=g.items.map(x=>x.className+' - '+x.subject).join(', ');
      jobs.push({key,phone:g.phone,message:'MANGAYA: Reminder. '+g.teacher+' has '+lines+' at '+String(Math.floor(g.mins/60)).padStart(2,'0')+':'+String(g.mins%60).padStart(2,'0')+'.',sendAt:at.getTime()});
    });
  }
  return jobs.filter(j=>j.sendAt>now-10*60*1000);
}
