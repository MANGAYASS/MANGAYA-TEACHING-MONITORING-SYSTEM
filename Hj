  }
  const clean=[],seen=new Set();
  for(const x of out){
    const u=String(x.username||"").trim(); if(!u)continue;
    const k=u.toLowerCase(); if(seen.has(k))continue;
    seen.add(k); x.role=x.role==="operator"||x.role==="head"?"operator"===x.role?"operator":"head":"teacher";
    x.label=roleLabel(x.role); clean.push(x);
